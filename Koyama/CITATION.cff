    affiliation: "Fred Hutchinson Cancer Center"
  - family-names: Furlan
    given-names: Scott N.
    affiliation: "Fred Hutchinson Cancer Center"
keywords:
  - single-cell RNA sequencing
  - graft-versus-host disease
  - intestinal stem cells
  - MHC class II
  - interferon gamma
  - BD Rhapsody
identifiers:
