    affiliation: "Fred Hutchinson Cancer Center"
  - family-names: Koyama
    given-names: Motoko
    affiliation: "Fred Hutchinson Cancer Center"
  - family-names: Hill
    given-names: Geoffrey R.
    affiliation: "Fred Hutchinson Cancer Center"
keywords:
  - single-cell RNA sequencing
  - graft-versus-host disease
  - intestinal stem cells
  - MHC class II
  - interferon gamma
  - BD Rhapsody
identifiers:
  - type: other
    value: "GSE348009"
    description: "NCBI GEO accession for the underlying data"
